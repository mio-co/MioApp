{
  "name": "mio-desktop",
  "productName": "Mio",
  "version": "0.3.0",
  "private": true,
  "description": "Mio desktop shell (Windows) for MioCore: main window + in-app browser with Ghostery adblocker",
  "author": "Smee238 <Smee238@users.noreply.github.com>",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "xyz.mio.desktop",
    "productName": "Mio",
    "copyright": "Mio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json", "!**/*.map"],
    "extraResources": [{ "from": "assets/adblock", "to": "adblock" }],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mio-Setup-${version}-x64.${ext}"
    },
    "portable": { "artifactName": "Mio-Portable-${version}-x64.${ext}" }
  }
}
