{
  "name": "mio-desktop",
  "productName": "Mio",
  "version": "0.3.0",
  "private": true,
  "description": "Mio desktop shell (Windows / macOS) for MioCore: main window + in-app browser with Ghostery adblocker",
  "author": "Smee238 <Smee238@users.noreply.github.com>",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "fetch-assets": "node scripts/fetch-assets.mjs assets/adblock",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --universal --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "tldts-experimental": "7.4.18"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "xyz.mio.desktop",
    "productName": "Mio",
    "copyright": "Mio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets/adblock",
        "to": "adblock"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mio-Setup-${version}-x64.${ext}",
      "shortcutName": "Mio"
    },
    "portable": {
      "artifactName": "Mio-Portable-${version}-x64.${ext}"
    },
    "asar": true,
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "artifactName": "Mio-${version}-mac-${arch}.${ext}"
    }
  }
}
