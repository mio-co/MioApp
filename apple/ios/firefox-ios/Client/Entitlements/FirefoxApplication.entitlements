<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mio: ad-hoc / SideStore distribution. Removed Mozilla-only or Apple-granted entitlements
	     (aps for Mozilla Autopush, Sign in with Apple, web-browser / browser.app-installation grants,
	     credential-provider extension, multipath). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.xyz.mio.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)xyz.mio.app</string>
	</array>
</dict>
</plist>
